# Copy to backend/.env for local development (never commit .env).
# Production values come from the deploy platform, not from a file.
APP_ENV=development
GIN_MODE=debug
HTTP_PORT=8080
# Shared dev database. Put the password in backend/.env only, never here.
DATABASE_URL=postgres://PithawaT:<password>@192.168.1.196:5432/bam_workspace?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000

# App session — random, at least 32 chars, NOT the SSO client secret.
# Generate: openssl rand -base64 48
APP_SESSION_SECRET=
APP_SESSION_TTL=12h

# Repair photos (D-022): persistent directory. Optional in development (default ./data/photos),
# required in UAT / production (mount a persistent volume and back it up).
PHOTO_STORAGE_DIR=data/photos

# Role switcher (D-005): dev/UAT only, ignored when APP_ENV=production
ROLE_SWITCHER_ENABLED=true

# RMC SSO — see docs/shared/integrations/sso.md
SSO_ISSUER=https://rmc-sso.cipcloud.net
SSO_AUTHORIZE_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/authorize
SSO_TOKEN_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/token
SSO_USERINFO_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/userinfo
SSO_END_SESSION_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/endsession
SSO_CLIENT_ID=bam
# copy from bam-sso-handoff.md (repo root, gitignored)
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback/rmc-sso
SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/signed-out
SSO_SCOPE=openid profile email offline_access
# Leeway for id_token iat/exp (default 60s, max 10m). The RMC SSO server clock runs ~2m11s ahead
# (measured 2026-10-15, D-037); remove this line once they fix it.
SSO_CLOCK_SKEW=5m
