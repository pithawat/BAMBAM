# Copy to backend/.env for local development (never commit .env).
# Production values come from the deploy platform, not from a file.
APP_ENV=development
GIN_MODE=debug
HTTP_PORT=8080
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SSO — see docs/shared/integrations/sso.md
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
