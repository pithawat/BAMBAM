# Committed. Non-secret development values only. Secrets → .env.local (not committed).
# The browser calls the API same-origin; next.config.ts rewrites /api/* to API_INTERNAL_URL.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://localhost:8080
# true = UI runs on mocks without the backend (Codex). For real SSO login set false in .env.local.
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_ROLE_SWITCHER=true
