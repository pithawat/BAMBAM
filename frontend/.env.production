# Committed. Non-secret production values only. NEXT_PUBLIC_* is baked in at build time.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Internal URL of the Go API as seen from the Next.js server (set by the deploy platform if different).
API_INTERNAL_URL=http://REPLACE-ME:8080
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_ROLE_SWITCHER=false
